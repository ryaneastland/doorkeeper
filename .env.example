# Copy to .env and fill in. Never commit .env — this repo is public.

# --- Supabase ---
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Service role key. Server-only: never rename it to PUBLIC_*, or it ships to every browser.
PRIVATE_SUPABASE_SERVICE_KEY=

# --- Site / geofence ---
PUBLIC_SITE_NAME=Moorooduc Fire Station
PUBLIC_SITE_LATITUDE=
PUBLIC_SITE_LONGITUDE=
# Optional (defaults 300 / 100)
PUBLIC_SITE_RADIUS_METRES=
PUBLIC_SITE_MAX_ACCURACY_METRES=
# Local development only: skips the proximity check entirely.
PUBLIC_GEOFENCE_DISABLED=false

# --- Door backend ---
# inner-range (default): Inner Range Inception REST, deploys serverless to Netlify.
# bosch: Bosch Solution via myAlarm, needs one persistent Node server (built with adapter-node).
DOOR_PROVIDER=inner-range
# Optional override of the build adapter: node | netlify (defaults from DOOR_PROVIDER).
ADAPTER=

# Doors (JSON array). id = stable key for entry_logs, target = Inception door GUID or Bosch door
# number, icon = door | roller. Optional for inner-range (defaults to the original three doors);
# required for bosch.
# DOORS=[{"id":"front","name":"Front Door","target":1,"icon":"door"}]
DOORS=

# --- Inner Range (DOOR_PROVIDER=inner-range) ---
PRIVATE_INCEPTION_USERNAME=
PRIVATE_INCEPTION_PASSWORD=
# e.g. https://skytunnel.com.au/inception/<serial>
PRIVATE_INCEPTION_BASE_URL=

# --- Bosch (DOOR_PROVIDER=bosch) --- see docs/BOSCH-INTEGRATION.md
BOSCH_HOST=ap.myalarms1.com
BOSCH_PORT=9050
BOSCH_SERIAL=
# One-time code, consumed by `npm run bosch:register -- --yes`
BOSCH_APPCODE=
BOSCH_DEVICEID=
BOSCH_USERPIN=
